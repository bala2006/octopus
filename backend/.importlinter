# Layer rules for import-linter. Run with `make lint-arch`, or `cd backend && .venv/bin/lint-imports`.
#
# main > channels > application > (kernel | plugins) > storage > (sdk | foundation)
# A plugin imports only the SDK, storage and foundation. The kernel does the same, so neither knows the other:
# they meet through the service registry, the tool registry and the run-method table.
[importlinter]
root_package = app
exclude_type_checking_imports = True

[importlinter:contract:layers]
name = Octopus layers
type = layers
layers =
    app.main
    app.bootstrap
    app.channels
    app.application
    app.kernel | app.plugins
    app.storage
    app.sdk | app.foundation

[importlinter:contract:plugins-are-independent]
name = Plugin packages do not import each other
type = independence
modules =
    app.plugins.browser
    app.plugins.mcp
    app.plugins.memory
    app.plugins.observers
    app.plugins.providers
    app.plugins.roles
    app.plugins.sandbox
    app.plugins.skills
    app.plugins.tools
    app.plugins.workflows
    app.plugins.workspace
