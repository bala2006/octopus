# ---------------------------------------------------------------------------
# Octopus runs 100% locally. Copy to .env (repo root or backend/) and adjust.
# ---------------------------------------------------------------------------

# Where the global registry lives (users, encrypted provider keys, MCP servers, list of projects).
# Per-project data is always stored inside each project: <project>/.octopus/
OCTOPUS_HOME=~/.octopus

# The one public address: http://127.0.0.1:<OCTOPUS_PORT>. Development serves the UI here and puts the backend on a
# nearby free internal port; production serves everything here. OCTOPUS_SKIP_BUILD=true reuses the existing UI build.
OCTOPUS_PORT=8000
OCTOPUS_SKIP_BUILD=false

# Directories users may pick as projects in the folder picker (JSON list)
WORKSPACE_ALLOWED_ROOTS=["~/code", "~/projects"]

# Security: change both for anything beyond a personal machine
SECRET_KEY=change-me-to-a-long-random-string
# Optional explicit Fernet key for encrypting API keys at rest (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Single-user mode (no login screen). Set false to require JWT auth.
SINGLE_USER_MODE=true

# Conversations use the existing host OpenCode installation by default.
# Optional: absolute path to that installed executable when it is not on PATH.
OPENCODE_EXECUTABLE=
DEFAULT_PROVIDER=opencode
DEFAULT_MODEL=default
# Reasoning effort when an agent/run says "Auto": none | low | medium | high | xhigh | max (xhigh = best quality for agent work)
DEFAULT_REASONING_EFFORT=xhigh
# Agents act through the model's native function calling where supported (Azure Responses API); false = JSON action envelope
NATIVE_TOOLS=true

# --- Azure OpenAI (model = deployment name, e.g. gpt-6-luna) ---
# Any v1 endpoint works and needs no api-version:
#   https://<resource>.openai.azure.com
#   https://<resource>.services.ai.azure.com/openai/v1/responses        (Responses API, default)
#   https://<resource>.services.ai.azure.com/openai/v1/chat/completions (Chat Completions API)
# Legacy .../openai/deployments/<name>/... URLs use AZURE_API_VERSION.
AZURE_API_BASE=https://<resource>.services.ai.azure.com/openai/v1/responses
AZURE_API_KEY=
AZURE_API_VERSION=2024-10-21

# Use Microsoft Entra ID (az login / managed identity) instead of API keys for Azure
AZURE_USE_ENTRA=false

# Code execution sandbox limits (no shell, scrubbed environment, project folder only)
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=1024

# Built-in browser for agents (Playwright MCP started by Octopus; needs Node 18+)
BROWSER_ENABLED=true
PLAYWRIGHT_BROWSER=            # chrome | msedge | chromium | firefox | webkit (empty: chrome if installed, else chromium)
PLAYWRIGHT_HEADLESS=true
BROWSER_LIVE_FRAMES=true       # screenshot each agent's tab after every browser action (the run's Browser tab)
BROWSER_LIVE_VIEW=true         # stream each agent's real tab live (Chromium/Chrome only) and let you take control

# Show the OS folder dialog for "Open project folder" (falls back to the in-app browser without a desktop)
NATIVE_DIALOGS=true

# Allow stdio MCP servers (they spawn commands you configure on this machine)
MCP_ALLOW_STDIO=true

# Run defaults / guardrails
DEFAULT_MAX_TURNS=60
DEFAULT_MAX_TOKENS_BUDGET=400000
DEFAULT_MAX_COST_USD=2.0
DEFAULT_TIMEOUT_S=900

LOG_LEVEL=INFO
LOG_JSON=false
