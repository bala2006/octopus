# Octopus runs on your computer. Copy this file to .env and adjust. Everything here is optional:
# the model connection can also be set in Settings → Model (that wins over these values).

# Where Octopus keeps settings, encrypted keys and the list of projects. Project data lives in <project>/.octopus/
OCTOPUS_HOME=~/.octopus
# The one address you open: http://127.0.0.1:<OCTOPUS_PORT>
OCTOPUS_PORT=8000
# Folders the in-app folder browser may show (separate with commas)
WORKSPACE_ALLOWED_ROOTS=

# Azure OpenAI: paste the endpoint as the portal shows it, e.g. https://<resource>.openai.azure.com
# or https://<resource>.services.ai.azure.com/openai/v1/responses
AZURE_API_BASE=
AZURE_API_KEY=
# Use Microsoft Entra ID (`az login`) instead of a key
AZURE_USE_ENTRA=false
# Deployment new agents use, and the thinking level when an agent is set to Auto (none|low|medium|high|xhigh|max)
DEFAULT_MODEL=gpt-6-luna
DEFAULT_REASONING_EFFORT=high

# Agents' built-in browser (Playwright MCP, isolated profile)
BROWSER_ENABLED=true
PLAYWRIGHT_HEADLESS=true
# Use the system folder dialog for "Open project folder"
NATIVE_DIALOGS=true
# Allow MCP servers that start a local command
MCP_ALLOW_STDIO=true
# Optional fixed key for encrypting secrets at rest (default: a random key in OCTOPUS_HOME/secret.key)
ENCRYPTION_KEY=
